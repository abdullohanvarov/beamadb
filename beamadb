def render_terminal_qr(payload):
    """Renders QR code in terminal using compact Unicode half-block characters"""
    try:
        import pyqrcode
    except ImportError:
        print(f"{Colors.YELLOW}pyqrcode module not found. Falling back to plain text code.{Colors.RESET}")
        return False

    qr = pyqrcode.create(payload)
    matrix = qr.code

    # Add quiet zone border of 2 modules
    border = 2
    w = len(matrix[0])
    full = [[0]*(w + 2*border)]*border
    for row in matrix:
        full.append([0]*border + row + [0]*border)
    full += [[0]*(w + 2*border)]*border
    if len(full) % 2 != 0:
        full.append([0]*len(full[0]))

    # Render with inverted half-blocks for standard dark terminal background
    # 0 = white module (solid on dark terminal), 1 = black module (space on dark terminal)
    lines = []
    for y in range(0, len(full), 2):
        line = []
        for x in range(len(full[y])):
            top = full[y][x]
            bot = full[y+1][x]
            if not top and not bot:
                line.append('█')
            elif not top and bot:
                line.append('▀')
            elif top and not bot:
                line.append('▄')
            else:
                line.append(' ')
        lines.append('  ' + ''.join(line))
    print('\n'.join(lines))
    return True

def cmd_pair_cli():
    print_banner()
    run_adb(["start-server"])

    session_id = uuid.uuid4().hex[:6]
    service_name = f"ADB-WIFI-{session_id.upper()}"
    pairing_code = f"{random.randint(100000, 999999)}"
    qr_payload = f"WIFI:T:ADB;S:{service_name};P:{pairing_code};;"

    print(f"\n{Colors.CYAN}{Colors.BOLD}📱 On your Android Phone:{Colors.RESET}")
    print(f"  1. Go to {Colors.BOLD}Settings > Developer options > Wireless debugging{Colors.RESET}")
    print(f"  2. Tap {Colors.BOLD}'Pair device with QR code'{Colors.RESET}")
    print(f"  3. Point your phone camera at this QR code:\n")

    rendered = render_terminal_qr(qr_payload)
    if not rendered:
        print(f"  Payload: {qr_payload}")

    print(f"\n  Pairing Code : {Colors.GREEN}{Colors.BOLD}{pairing_code}{Colors.RESET}")
    print(f"  Service Name : {Colors.DIM}{service_name}{Colors.RESET}")
    print(f"\n{Colors.YELLOW}[*] Listening on local Wi-Fi for phone scan... (Press Ctrl+C to cancel){Colors.RESET}")

    start_time = time.time()
    paired_host = None

    try:
        while time.time() - start_time < 120:
            # Poll discovered services
            _, out, _ = run_adb(["mdns", "services"], timeout=2)
            for line in out.splitlines():
                parts = re.split(r'\s+', line.strip())
                if len(parts) >= 3 and parts[1] == "_adb-tls-pairing._tcp":
                    svc_name = parts[0]
                    addr = parts[2]
                    host, port = addr.split(":", 1) if ":" in addr else (addr, "")
                    
                    if service_name in svc_name or (time.time() - start_time > 3 and not paired_host):
                        print(f"\n{Colors.GREEN}[+] Phone detected at {host}:{port}!{Colors.RESET}")
                        print(f"[*] Authenticating TLS pairing keys...")
                        
                        p_code, p_out, p_err = run_adb(["pair", f"{host}:{port}", pairing_code], timeout=15)
                        full_pair = f"{p_out}\n{p_err}".strip()
                        
                        if "Successfully paired" in full_pair or p_code == 0:
                            print(f"{Colors.GREEN}[✓] Pairing Successful!{Colors.RESET}")
                            print(f"[*] Establishing wireless connection...")
                            paired_host = host
                            break
                        else:
                            print(f"{Colors.RED}[!] Pairing failed: {full_pair}{Colors.RESET}")
                            return

            if paired_host:
                break
            time.sleep(1.0)

        if not paired_host:
            print(f"\n{Colors.RED}[!] Pairing timed out. Ensure your phone and PC are on the exact same Wi-Fi network.{Colors.RESET}")
            return

        # Connect step
        time.sleep(1.0)
        connected = False
        for _ in range(8):
            _, out, _ = run_adb(["mdns", "services"], timeout=2)
            for line in out.splitlines():
                parts = re.split(r'\s+', line.strip())
                if len(parts) >= 3 and parts[1] == "_adb-tls-connect._tcp":
                    addr = parts[2]
                    h, p = addr.split(":", 1) if ":" in addr else (addr, "")
                    if h == paired_host:
                        target = f"{h}:{p}"
                        print(f"[*] Connecting to {target}...")
                        c_code, c_out, _ = run_adb(["connect", target], timeout=8)
                        if "connected to" in c_out.lower() or c_code == 0:
                            print(f"{Colors.GREEN}{Colors.BOLD}[✓] Successfully connected to {target}! 🎉{Colors.RESET}")
                            connected = True
                            break
            if connected:
                break
            time.sleep(1.0)

        if not connected:
            # Check devices
            _, d_out, _ = run_adb(["devices"], timeout=2)
            if paired_host in d_out:
                print(f"{Colors.GREEN}{Colors.BOLD}[✓] Device auto-connected via ADB mDNS! 🎉{Colors.RESET}")
            else:
                print(f"{Colors.YELLOW}[*] Paired! If not auto-connected, check the IP & Port on your Wireless Debugging screen and run:{Colors.RESET}")
                print(f"    beamadb connect {paired_host}:<PORT>")

    except KeyboardInterrupt:
        print(f"\n{Colors.YELLOW}[*] Pairing cancelled by user.{Colors.RESET}")

def cmd_manual_pair(args):
    if len(args) < 2:
        print("Usage: beamadb code <ip:port> <6-digit-code> [connect-port]")
        return
    target = args[0]
    code = args[1]
    connect_port = args[2] if len(args) > 2 else None

    print(f"[*] Pairing with {target} using code {code}...")
    p_code, p_out, p_err = run_adb(["pair", target, code], timeout=15)
    full_out = f"{p_out}\n{p_err}".strip()
    if "Successfully paired" in full_out or p_code == 0:
        print(f"{Colors.GREEN}[✓] Successfully paired to {target}!{Colors.RESET}")
        host = target.split(":")[0]
        if connect_port:
            conn_target = f"{host}:{connect_port}"
            print(f"[*] Connecting to {conn_target}...")
            _, c_out, _ = run_adb(["connect", conn_target], timeout=8)
            print(c_out)
        else:
            print(f"[*] You can now connect using: beamadb connect {host}:<CONNECT_PORT>")
    else:
        print(f"{Colors.RED}[!] Pairing failed: {full_out}{Colors.RESET}")

def cmd_connect(args):
    if not args:
        print("Usage: beamadb connect <ip:port>")
        return
    target = args[0]
    if ":" not in target:
        target = f"{target}:5555"
    print(f"[*] Connecting to {target}...")
    _, out, err = run_adb(["connect", target], timeout=8)
    print(out or err)

def cmd_disconnect(args):
    target = args[0] if args else ""
    if target and target.lower() != "all":
        print(f"[*] Disconnecting {target}...")
        _, out, err = run_adb(["disconnect", target], timeout=6)
        print(out or err)
    else:
        print("[*] Disconnecting all wireless devices...")
        _, out, err = run_adb(["disconnect"], timeout=6)
        print(out or err)

def cmd_devices():
    _, out, _ = run_adb(["devices", "-l"], timeout=4)
    lines = out.splitlines()
    print(f"{Colors.BOLD}{lines[0] if lines else 'List of devices attached'}{Colors.RESET}")
    for line in lines[1:]:
        line = line.strip()
        if not line:
            continue
        parts = re.split(r'\s+', line)
        serial = parts[0]
        status = parts[1] if len(parts) > 1 else ""
        is_wireless = bool(re.match(r'^\d+\.\d+\.\d+\.\d+:\d+$', serial))
        color = Colors.CYAN if is_wireless else Colors.GREEN
        type_badge = f"{Colors.BOLD}[Wi-Fi]{Colors.RESET}" if is_wireless else f"{Colors.BOLD}[USB]{Colors.RESET}"
        print(f"  {color}{serial:<24}{Colors.RESET} {type_badge} {status} {' '.join(parts[2:])}")

def cmd_discovered():
    print(f"{Colors.BOLD}Scanning local network for ADB mDNS endpoints...{Colors.RESET}\n")
    _, out, _ = run_adb(["mdns", "services"], timeout=3)
    lines = out.splitlines()
    found = False
    for line in lines:
        parts = re.split(r'\s+', line.strip())
        if len(parts) >= 3 and ("_tcp" in parts[1] or "_adb" in parts[1]):
            found = True
            name = parts[0]
            stype = parts[1]
            addr = parts[2]
            badge = f"{Colors.YELLOW}[Pairing]{Colors.RESET}" if "pairing" in stype else f"{Colors.GREEN}[Connect]{Colors.RESET}"
            print(f"  {badge:<18} {addr:<22} {name} ({stype})")
    if not found:
        print("  No mDNS endpoints currently broadcasting on this subnet.")

def cmd_usb():
    _, out, _ = run_adb(["devices"], timeout=3)
    usb_devs = []
    for line in out.splitlines()[1:]:
        parts = re.split(r'\s+', line.strip())
        if len(parts) >= 2 and parts[1] == "device":
            if not re.match(r'^\d+\.\d+\.\d+\.\d+:\d+$', parts[0]):
                usb_devs.append(parts[0])

    if not usb_devs:
        print(f"{Colors.YELLOW}[!] No USB devices detected with status 'device'. Connect phone via USB first.{Colors.RESET}")
        return

    dev = usb_devs[0]
    print(f"[*] Found USB device: {dev}")
    print(f"[*] Activating TCP/IP mode on port 5555...")
    run_adb(["-s", dev, "tcpip", "5555"], timeout=8)
    time.sleep(1.0)

    # Detect IP
    _, ip_out, _ = run_adb(["-s", dev, "shell", "ip -4 route show"], timeout=3)
    m = re.search(r'dev\s+wlan0\s+proto\s+\w+\s+scope\s+\w+\s+src\s+([\d\.]+)', ip_out)
    ip_addr = m.group(1) if m else None
    if not ip_addr:
        _, ip_out2, _ = run_adb(["-s", dev, "shell", "ip -4 addr show wlan0"], timeout=3)
        m2 = re.search(r'inet\s+([\d\.]+)/', ip_out2)
        ip_addr = m2.group(1) if m2 else None

    if not ip_addr:
        print(f"{Colors.YELLOW}[!] TCP/IP 5555 enabled, but could not detect Wi-Fi IP automatically.{Colors.RESET}")
        print("Check your phone Wi-Fi IP in Settings > About Phone > Status, then run: beamadb connect <IP>:5555")
        return

    target = f"{ip_addr}:5555"
    print(f"[*] Connecting wirelessly to {target}...")
    _, c_out, _ = run_adb(["connect", target], timeout=8)
    print(f"{Colors.GREEN}{Colors.BOLD}[✓] Switched to wireless mode ({target})! You can now unplug the USB cable. 🎉{Colors.RESET}")

def get_first_connected_device():
    devs = get_connected_devices()
    if not devs:
        return None
    return devs[0].get("serial")

def cmd_scrcpy(args):
    if not shutil.which("scrcpy"):
        print(f"{Colors.RED}[!] scrcpy is not installed. Install with: sudo apt install scrcpy{Colors.RESET}")
        return

    device = args[0] if args and not args[0].startswith("-") else get_first_connected_device()
    if not device:
        print(f"{Colors.YELLOW}[!] No connected devices found. Connect a device first.{Colors.RESET}")
        return

    extra_args = [a for a in args if a != device]
    cmd = ["scrcpy", "-s", device, f"--window-title=BeamADB: {device}"] + extra_args
    print(f"[*] Launching scrcpy for {device}...")
    subprocess.run(cmd)

