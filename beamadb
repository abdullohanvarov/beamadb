#!/usr/bin/env python3
"""
BeamADB - Unified CLI & GUI Launcher
Usage:
  beamadb [command]

Commands:
  (no args) / ui / gui   Launch BeamADB graphical web interface in browser
  pair / qr              Terminal QR pairing mode: scan QR code directly in terminal
  code <ip:port> <code>  Manual pair with IP, port, and 6-digit pairing code
  connect <ip:port>      Connect to an already-paired device (or default port 5555)
  disconnect [device]    Disconnect a wireless device (or all devices)
  devices / list         List currently connected devices
  discovered / mdns      List discovered ADB endpoints on local Wi-Fi
  usb                    Switch currently plugged-in USB device to wireless
  restart                Restart ADB server
  status                 Check ADB daemon and background server status
  help / --help / -h     Show this help message
"""

import sys
import os
import time
import subprocess
import re
import uuid
import random
import signal
from pathlib import Path

# Ensure unbuffered output in terminals and pipes
try:
    sys.stdout.reconfigure(line_buffering=True)
except Exception:
    pass

# Resolve directory of BeamADB
BASE_DIR = Path(__file__).resolve().parent
# If installed in /usr/bin, package data is in /usr/share/beamadb
if not (BASE_DIR / "server.py").exists() and Path("/usr/share/beamadb/server.py").exists():
    APP_DIR = Path("/usr/share/beamadb")
else:
    APP_DIR = BASE_DIR

# Add pyqrcode to sys.path
sys.path.insert(0, str(APP_DIR))

PORT = 5588
URL = f"http://localhost:{PORT}"

def get_adb():
    candidates = [
        os.environ.get("ADB_PATH"),
        "/home/abdulloh/.local/bin/adb",
        "/home/abdulloh/Android/Sdk/platform-tools/adb",
        "adb"
    ]
    for c in candidates:
        if not c:
            continue
        try:
            res = subprocess.run([c, "version"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=2)
            if res.returncode == 0:
                return c
        except Exception:
            continue
    return "adb"

ADB_BIN = get_adb()

def run_adb(args, timeout=10):
    cmd = [ADB_BIN] + [str(a) for a in args]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return -1, "", str(e)

# Colors for terminal output
