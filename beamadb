def cmd_pull(args):
    if len(args) < 2:
        print("Usage: beamadb pull <device> <remote_path> [local_path]")
        return
    device = args[0]
    remote_path = args[1]
    local_path = args[2] if len(args) > 2 else "."
    print(f"[*] Pulling {remote_path} from {device} to {local_path}...")
    code, out, err = run_adb(["-s", device, "pull", remote_path, local_path], timeout=180)
    print(out or err)

def cmd_push(args):
    if len(args) < 3:
        print("Usage: beamadb push <device> <local_path> <remote_path>")
        return
    device = args[0]
    local_path = args[1]
    remote_path = args[2]
    print(f"[*] Pushing {local_path} to {device}:{remote_path}...")
    code, out, err = run_adb(["-s", device, "push", local_path, remote_path], timeout=180)
    print(out or err)

def cmd_rm(args):
    if len(args) < 2:
        print("Usage: beamadb rm <device> <remote_path>")
        return
    device = args[0]
    remote_path = args[1]
    print(f"[*] Deleting {remote_path} on {device}...")
    code, out, err = run_adb(["-s", device, "shell", "rm", "-rf", remote_path], timeout=15)
    print(f"{Colors.GREEN}[✓] Deleted {remote_path}{Colors.RESET}")

def cmd_files(args):
    device = args[0] if args and not args[0].startswith("-") else get_first_connected_device()
    path = args[1] if len(args) > 1 else "/sdcard"
    if not device:
        print(f"{Colors.YELLOW}[!] No connected devices found.{Colors.RESET}")
        return
    print(f"[*] Listing {path} on {device}:")
    code, out, err = run_adb(["-s", device, "shell", f"ls -la '{path}/'"], timeout=10)
    print(out or err)

def is_server_running():
    try:
        import urllib.request
        with urllib.request.urlopen(f"{URL}/api/status", timeout=1) as r:
            return r.status == 200
    except Exception:
        return False

def start_server_daemon():
    if is_server_running():
        return True
    
    server_script = APP_DIR / "server.py"
    log_file = APP_DIR / "server.log"
    subprocess.Popen(
        [sys.executable, "-u", str(server_script)],
        stdout=open(log_file, "a"),
        stderr=subprocess.STDOUT,
        preexec_fn=os.setpgrp
    )
    for _ in range(25):
        if is_server_running():
            return True
        time.sleep(0.2)
    return False

def cmd_ui():
    print(f"[*] Starting BeamADB GUI on {URL}...")
    if not is_server_running():
        start_server_daemon()
    
    # Open browser
    try:
        if subprocess.run(["which", "xdg-open"], stdout=subprocess.DEVNULL).returncode == 0:
            subprocess.Popen(["xdg-open", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif subprocess.run(["which", "firefox"], stdout=subprocess.DEVNULL).returncode == 0:
            subprocess.Popen(["firefox", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif subprocess.run(["which", "google-chrome"], stdout=subprocess.DEVNULL).returncode == 0:
            subprocess.Popen(["google-chrome", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            print(f"Please open {URL} in your browser.")
    except Exception:
        print(f"Please open {URL} in your browser.")

def cmd_help():
    print_banner()
    print("""
Usage:
  beamadb [command] [options]

Commands:
  (no args)             Launch BeamADB GUI web application in your browser
  ui, gui               Explicitly open GUI web interface
  pair, qr              Terminal QR pairing mode: pair using terminal QR code
  code <host:port> <code> [connect_port]
                        Pair manually using IP, pairing port, and 6-digit code
  connect <host:port>   Connect to a device wirelessly (default port: 5555)
  disconnect [device]   Disconnect a wireless device (or all devices)
  devices, list, ls     List currently attached USB and wireless devices
  discovered, mdns      List local Wi-Fi mDNS ADB pairing and connect services
  usb                   Switch currently plugged-in USB phone to wireless (tcpip 5555)
  scrcpy [device]       Launch scrcpy screen mirroring for a connected device
  camera [device]       Launch scrcpy camera mirroring (requires Android 12+)
  files [device] [path] List files in directory on a device
  pull <device> <remote> [local]
                        Download/pull a file or directory from device
  push <device> <local> <remote>
                        Upload/push a file or directory to device
  rm <device> <remote>  Delete a file or directory on device
  restart               Restart ADB server daemon
  status                Show server status and active ports
  help, --help, -h      Display this documentation
""")

def main():
    args = sys.argv[1:]
    if not args:
        cmd_ui()
        return

    cmd = args[0].lower()
    if cmd in ("ui", "gui", "start", "web"):
        cmd_ui()
    elif cmd in ("pair", "qr"):
        cmd_pair_cli()
    elif cmd in ("code", "manual"):
        cmd_manual_pair(args[1:])
    elif cmd in ("connect", "c"):
        cmd_connect(args[1:])
    elif cmd in ("disconnect", "d"):
        cmd_disconnect(args[1:])
    elif cmd in ("devices", "device", "list", "ls"):
        cmd_devices()
    elif cmd in ("discovered", "mdns", "scan"):
        cmd_discovered()
    elif cmd in ("usb", "tcpip"):
        cmd_usb()
    elif cmd in ("scrcpy", "mirror"):
        cmd_scrcpy(args[1:])
    elif cmd in ("camera", "cam"):
        cmd_camera(args[1:])
    elif cmd in ("files", "tree"):
        cmd_files(args[1:])
    elif cmd in ("pull", "download"):
        cmd_pull(args[1:])
    elif cmd in ("push", "upload"):
        cmd_push(args[1:])
    elif cmd in ("rm", "delete"):
        cmd_rm(args[1:])
    elif cmd in ("restart", "kill"):
        print("[*] Restarting ADB daemon...")
        run_adb(["kill-server"])
        time.sleep(0.5)
        run_adb(["start-server"])
        print(f"{Colors.GREEN}[✓] ADB server restarted.{Colors.RESET}")
    elif cmd in ("status", "info"):
        running = is_server_running()
        status_color = Colors.GREEN if running else Colors.RED
        print(f"ADB Binary       : {ADB_BIN}")
        print(f"BeamADB Web Server: {status_color}{'Running' if running else 'Stopped'}{Colors.RESET} ({URL})")
        cmd_devices()
    elif cmd in ("help", "--help", "-h"):
        cmd_help()
    else:
        print(f"{Colors.RED}Unknown command: {cmd}{Colors.RESET}")
        cmd_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
